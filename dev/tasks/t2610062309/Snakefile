import sys
from pathlib import Path
sys.path.insert(0, str(Path.cwd()))
from blueearth_cst.shared.console_style import install_console_style
from blueearth_cst.shared.snake_utils import patch_psutil_windows_benchmark
patch_psutil_windows_benchmark()
onstart:
    install_console_style()
rule all:
    input: expand('.tmp/scratchpad/wf2-scheduler-probe/out/{i}.txt', i=range(125))
rule fetch:
    output: '.tmp/scratchpad/wf2-scheduler-probe/out/{i}.raw'
    benchmark: '.tmp/scratchpad/wf2-scheduler-probe/bench/{i}.fetch.tsv'
    shell: 'python -c "import pathlib,time; time.sleep(0.01); pathlib.Path(r\'{output}\').write_text(\'fetch\')"'
rule reduce:
    input: '.tmp/scratchpad/wf2-scheduler-probe/out/{i}.raw'
    output: '.tmp/scratchpad/wf2-scheduler-probe/out/{i}.txt'
    benchmark: '.tmp/scratchpad/wf2-scheduler-probe/bench/{i}.reduce.tsv'
    shell: 'python -c "import pathlib; pathlib.Path(r\'{output}\').write_text(\'reduce\')"'
