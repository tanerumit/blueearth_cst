#!/bin/sh
# Restore the visible main-board link after checkout replaces a tracked snapshot.
if command -v pwsh >/dev/null 2>&1 && test -f dev/scripts/setup-board-view.ps1; then
    pwsh -NoProfile -File dev/scripts/setup-board-view.ps1
fi

# Direct terminal Git bypasses runtime guards; diagnose without reverting it.
if test "$GIT_WORKFLOW_MANAGED" != "1"; then
    backend=.agents/skills/git-workflow/scripts/worktree-session.py
    if command -v python >/dev/null 2>&1 && test -f "$backend"; then
        python "$backend" session-check --warn-only
    fi
fi
exit 0
